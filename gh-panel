#!/usr/bin/env python3
"""Entry point for the Green Heron switch panel TUI."""

import argparse
import curses
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from greenheron import protocol as p
from greenheron import tui


def main() -> int:
    ap = argparse.ArgumentParser(description="Green Heron remote switch panel")
    ap.add_argument("host", nargs="?", default=os.environ.get("GH_SWITCH_HOST"),
                    help="switch address; defaults to $GH_SWITCH_HOST")
    ap.add_argument("-p", "--port", type=int, default=p.DEFAULT_PORT)
    ap.add_argument("--dry-run", action="store_true",
                    help="never transmit: exercise the panel without moving relays")
    ap.add_argument("--no-keepalive", action="store_true",
                    help="omit the 5 s NUL keepalive the official client sends")
    args = ap.parse_args()

    if not args.host:
        ap.error("no switch address given; pass one or set $GH_SWITCH_HOST")

    try:
        curses.wrapper(tui.run, args.host, args.port, args.dry_run,
                       not args.no_keepalive)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
