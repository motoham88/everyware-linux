# Environment for the gh-mqtt systemd unit.
# Copy to ~/.config/gh-mqtt.env and chmod 600 -- it holds broker credentials.

# The antenna switch
GH_SWITCH_HOST=192.0.2.10

# The MQTT broker. For Home Assistant's Mosquitto add-on this is the HA host,
# port 1883, with a Home Assistant user you created for the purpose.
GH_MQTT_BROKER=192.0.2.20
GH_MQTT_PORT=1883
GH_MQTT_USERNAME=
GH_MQTT_PASSWORD=
